# Application ID aus dem Enable Banking Control Panel (https://enablebanking.com/cp/applications)
EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000

# Pfad zum privaten Schlüssel im Container (wird per docker-compose aus ./secrets/private.pem gemountet)
EB_PRIVATE_KEY_PATH=/secrets/private.pem

# Bei der Anwendung hinterlegte Redirect-URL
EB_REDIRECT_URL=https://localhost/callback

# Bank: Name exakt wie von "enable-banking banks" ausgegeben
EB_ASPSP_NAME=
EB_ASPSP_COUNTRY=DE
# personal oder business
EB_PSU_TYPE=personal

# Gültigkeit der Zustimmung in Tagen (bankabhängig, meist max. 90 oder 180)
EB_ACCESS_DAYS=180

# Abrufintervall in Sekunden (Standard: 6 Stunden). Banken begrenzen Abrufe ohne
# Nutzerinteraktion häufig auf 4 pro Tag – kürzere Intervalle sind nicht empfehlenswert.
EB_FETCH_INTERVAL_SECONDS=21600

# Erster Abruf: so viele Tage rückwirkend
EB_INITIAL_DAYS=90
# Folgeabrufe: ab letzter Buchung minus so viele Tage (fängt Nachbuchungen ab)
EB_OVERLAP_DAYS=10

EB_LOG_LEVEL=INFO

# --- Exportseite (http://<server>:8080/) ----------------------------------
# Zugriffstoken, erzeugen z. B. mit: openssl rand -hex 32
# Skripte senden es als Header "Authorization: Bearer <token>", im Browser wird es
# als Passwort abgefragt (Benutzername beliebig). Ohne Token ist die Seite gesperrt.
EB_WEB_TOKEN=

# --- Nur für docker compose (Host-Seite) ----------------------------------
# Netzwerkadresse und Port, unter denen die Exportseite auf dem Host erreichbar ist
#EB_WEB_BIND=0.0.0.0
#EB_WEB_HOST_PORT=8080
# Host-Pfade für Datenverzeichnis und privaten Schlüssel
#EB_DATA_PATH=./data
#EB_KEY_PATH=./secrets/private.pem
