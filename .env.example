# Alle Angaben sind optional: Application ID, Schlüssel und Redirect-URL werden in der
# Weboberfläche (http://<server>:8080/ → Einstellungen) eingetragen. Werte hier dienen nur als
# Vorbelegung; Einträge aus der Weboberfläche haben Vorrang.

#EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000
#EB_REDIRECT_URL=https://bank.example.org/callback
#EB_ASPSP_NAME=
#EB_ASPSP_COUNTRY=DE
#EB_PSU_TYPE=personal
#EB_ACCESS_DAYS=180

# Die Abrufzeiten je Wochentag stehen in der Weboberfläche unter Einstellungen. Sie gelten in
# dieser Zeitzone (Standard im Container: Europe/Berlin).
#TZ=Europe/Berlin
#EB_INITIAL_DAYS=90
#EB_OVERLAP_DAYS=10
#EB_LOG_LEVEL=INFO

# Login der Weboberfläche (nur aktiv, wenn beide gesetzt sind; sonst ohne Zugriffsschutz)
#EB_WEB_USER=
#EB_WEB_PASSWORD=

# Export-Pfad /export für Skripte. Basic Auth nur, wenn Benutzer und Passwort gesetzt sind;
# sonst ist er frei abrufbar. Mit false abgeschaltet.
#EB_EXPORT_ENABLED=true
#EB_EXPORT_USER=
#EB_EXPORT_PASSWORD=

# E-Mail an den Notfallkontakt, wenn die Bank eine erneute Anmeldung verlangt und der
# automatische Abruf deshalb gestoppt wird; ohne neue Verbindung Erinnerungen nach 7 und 14 Tagen.
# Test-Mail unter Einstellungen.
#EB_SMTP_HOST=smtp.example.org
#EB_SMTP_PORT=587
#EB_SMTP_SECURITY=starttls
#EB_SMTP_USER=banking@example.org
#EB_SMTP_PASSWORD=
#EB_SMTP_FROM=banking@example.org
# Standard für den Notfallkontakt, mehrere durch Komma getrennt. Unter Einstellungen lassen sich
# andere Adressen eintragen; sie haben Vorrang und bleiben nach einem Neustart erhalten.
#EB_ALERT_EMAIL=ich@example.org

# Nur für docker compose (Host-Seite)
#EB_DATA_PATH=./data
#EB_WEB_BIND=0.0.0.0
#EB_WEB_HOST_PORT=8080
